{
  "openapi": "3.1.0",
  "info": {
    "title": "ESG Analytics API",
    "version": "1.0.0",
    "description": "Read-only API for illustrative company records and source-backed CCRI risk analytics."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local Docker Compose environment"
    }
  ],
  "tags": [
    { "name": "System", "description": "Service discovery, liveness, and readiness" },
    { "name": "Companies", "description": "Illustrative company records" },
    { "name": "Risk analytics", "description": "Normalized CCRI research data" }
  ],
  "paths": {
    "/": {
      "get": {
        "operationId": "getApiIndex",
        "summary": "List the public API endpoints",
        "tags": ["System"],
        "responses": {
          "200": {
            "description": "API name and endpoint map",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiIndex" }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Report process liveness",
        "tags": ["System"],
        "responses": {
          "200": {
            "description": "Healthy service response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Health" }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "operationId": "getReadiness",
        "summary": "Report service and PostgreSQL readiness",
        "tags": ["System"],
        "responses": {
          "200": {
            "description": "Service and database are ready",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Readiness" }
              }
            }
          },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "getOpenApiContract",
        "summary": "Return this OpenAPI contract",
        "tags": ["System"],
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 document",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OpenApiDocument" }
              }
            }
          }
        }
      }
    },
    "/api/companies": {
      "get": {
        "operationId": "listCompanies",
        "summary": "List illustrative company records",
        "tags": ["Companies"],
        "responses": {
          "200": {
            "description": "Structured company collection",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CompanyCollection" }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalServerError" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/api/risk-summary": {
      "get": {
        "operationId": "getRiskSummary",
        "summary": "Return verified CCRI totals and distributions",
        "tags": ["Risk analytics"],
        "responses": {
          "200": {
            "description": "Verified risk summary",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RiskSummaryResponse" }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalServerError" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/api/risk-events": {
      "get": {
        "operationId": "listRiskEvents",
        "summary": "Filter and paginate normalized CCRI risk events",
        "tags": ["Risk analytics"],
        "parameters": [
          { "$ref": "#/components/parameters/Grade" },
          { "$ref": "#/components/parameters/MajorClass" },
          { "$ref": "#/components/parameters/CompanyCode" },
          { "$ref": "#/components/parameters/Limit" },
          { "$ref": "#/components/parameters/Offset" }
        ],
        "responses": {
          "200": {
            "description": "Filtered risk-event page",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RiskEventCollection" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/InvalidQueryParameter" },
          "500": { "$ref": "#/components/responses/InternalServerError" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/company": {
      "get": {
        "operationId": "listLegacyCompanies",
        "summary": "List companies using the original response shape",
        "description": "Compatibility endpoint retained while clients migrate to /api/companies.",
        "deprecated": true,
        "tags": ["Companies"],
        "responses": {
          "200": {
            "description": "Legacy company array",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Company" }
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalServerError" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "Grade": {
        "name": "grade",
        "in": "query",
        "description": "Numeric CCRI grade or the source's special D code.",
        "schema": {
          "type": "string",
          "enum": ["3", "4", "5", "6", "7", "8", "9", "D"]
        }
      },
      "MajorClass": {
        "name": "majorClass",
        "in": "query",
        "description": "Exact major risk-class label.",
        "schema": { "type": "string", "minLength": 1, "maxLength": 100 }
      },
      "CompanyCode": {
        "name": "companyCode",
        "in": "query",
        "description": "Six-digit source company code.",
        "schema": { "type": "string", "pattern": "^[0-9]{6}$" }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "description": "Maximum events returned in one page.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      },
      "Offset": {
        "name": "offset",
        "in": "query",
        "description": "Number of matching events skipped.",
        "schema": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000,
          "default": 0
        }
      }
    },
    "responses": {
      "InvalidQueryParameter": {
        "description": "Unsupported or malformed query parameter",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": {
              "error": {
                "code": "INVALID_QUERY_PARAMETER",
                "message": "grade must be 3-9 or D"
              }
            }
          }
        }
      },
      "InternalServerError": {
        "description": "Unexpected or invalid internal data",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "ServiceUnavailable": {
        "description": "Database-backed data is temporarily unavailable",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      }
    },
    "schemas": {
      "ApiIndex": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "endpoints"],
        "properties": {
          "name": { "type": "string", "const": "ESG Analytics API" },
          "endpoints": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "health",
              "readiness",
              "apiContract",
              "companies",
              "riskSummary",
              "riskEvents",
              "legacyCompanies"
            ],
            "properties": {
              "health": { "type": "string", "const": "/health" },
              "readiness": { "type": "string", "const": "/ready" },
              "apiContract": { "type": "string", "const": "/openapi.json" },
              "companies": { "type": "string", "const": "/api/companies" },
              "riskSummary": { "type": "string", "const": "/api/risk-summary" },
              "riskEvents": { "type": "string", "const": "/api/risk-events" },
              "legacyCompanies": { "type": "string", "const": "/company" }
            }
          }
        }
      },
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "service"],
        "properties": {
          "status": { "type": "string", "const": "ok" },
          "service": { "type": "string", "const": "esg-api" }
        }
      },
      "Readiness": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "service", "dependencies"],
        "properties": {
          "status": { "type": "string", "const": "ready" },
          "service": { "type": "string", "const": "esg-api" },
          "dependencies": {
            "type": "object",
            "additionalProperties": false,
            "required": ["database"],
            "properties": {
              "database": { "type": "string", "const": "up" }
            }
          }
        }
      },
      "OpenApiDocument": {
        "type": "object",
        "required": ["openapi", "info", "paths"],
        "properties": {
          "openapi": { "type": "string" },
          "info": { "type": "object" },
          "paths": { "type": "object" }
        },
        "additionalProperties": true
      },
      "Company": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": {
            "description": "PostgreSQL BIGSERIAL identifier.",
            "oneOf": [
              { "type": "integer", "minimum": 1 },
              { "type": "string", "pattern": "^[1-9][0-9]*$" }
            ]
          },
          "name": { "type": "string", "minLength": 1 }
        }
      },
      "CompanyCollection": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data", "meta"],
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Company" }
          },
          "meta": {
            "type": "object",
            "additionalProperties": false,
            "required": ["count"],
            "properties": {
              "count": { "type": "integer", "minimum": 0 }
            }
          }
        }
      },
      "DistributionCount": {
        "type": "integer",
        "minimum": 0
      },
      "RiskSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "eventCount",
          "companyCount",
          "majorClassCount",
          "subcategoryCount",
          "numericGradeCount",
          "specialGradeEventCount",
          "gradeDistribution",
          "classDistribution"
        ],
        "properties": {
          "eventCount": { "type": "integer", "minimum": 0 },
          "companyCount": { "type": "integer", "minimum": 0 },
          "majorClassCount": { "type": "integer", "minimum": 0 },
          "subcategoryCount": { "type": "integer", "minimum": 0 },
          "numericGradeCount": { "type": "integer", "minimum": 0 },
          "specialGradeEventCount": { "type": "integer", "minimum": 0 },
          "gradeDistribution": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["grade", "count"],
              "properties": {
                "grade": {
                  "type": "string",
                  "enum": ["3", "4", "5", "6", "7", "8", "9", "D"]
                },
                "count": { "$ref": "#/components/schemas/DistributionCount" }
              }
            }
          },
          "classDistribution": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["majorClass", "count"],
              "properties": {
                "majorClass": { "type": "string", "minLength": 1 },
                "count": { "$ref": "#/components/schemas/DistributionCount" }
              }
            }
          }
        }
      },
      "RiskSummaryResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data"],
        "properties": {
          "data": { "$ref": "#/components/schemas/RiskSummary" }
        }
      },
      "RiskEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sourceRow",
          "companyCode",
          "companyName",
          "eventDate",
          "eventCode",
          "ccriGrade",
          "dataPeriod",
          "majorClass",
          "subcategory"
        ],
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "sourceRow": { "type": "integer", "minimum": 2 },
          "companyCode": { "type": "string", "pattern": "^[0-9]{6}$" },
          "companyName": { "type": "string", "minLength": 1 },
          "eventDate": { "type": "string", "format": "date" },
          "eventCode": { "type": "string", "pattern": "^[A-Z][0-9]{7}$" },
          "ccriGrade": {
            "type": "string",
            "enum": ["3", "4", "5", "6", "7", "8", "9", "D"]
          },
          "dataPeriod": { "type": "string", "pattern": "^[0-9]{4}/[0-9]{2}$" },
          "majorClass": { "type": "string", "minLength": 1 },
          "subcategory": { "type": "string", "minLength": 1 }
        }
      },
      "RiskEventCollection": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data", "meta"],
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/RiskEvent" }
          },
          "meta": {
            "type": "object",
            "additionalProperties": false,
            "required": ["total", "count", "limit", "offset"],
            "properties": {
              "total": { "type": "integer", "minimum": 0 },
              "count": { "type": "integer", "minimum": 0, "maximum": 100 },
              "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
              "offset": { "type": "integer", "minimum": 0, "maximum": 10000 }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string", "minLength": 1 },
              "message": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
