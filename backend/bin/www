#!/usr/bin/env node

require("dotenv").config({ quiet: true });

const { createApp } = require("../app");
const {
  closeDatabase,
  createDatabase,
} = require("../src/config/database");
const {
  resolveMigrationsDirectory,
  runMigrations,
} = require("../src/database/migrationRunner");
const {
  defaultLifecycleLogger,
  normalizePort,
  startServer,
} = require("../src/serverLifecycle");

async function main() {
  const database = createDatabase();
  await runMigrations({
    database,
    migrationsDirectory: resolveMigrationsDirectory(),
    logEvent: defaultLifecycleLogger,
  });

  const app = createApp({ database });
  const port = normalizePort(process.env.PORT || "3000");

  app.set("port", port);
  startServer({
    app,
    port,
    closeResources: () => closeDatabase(database),
  });
}

main().catch((error) => {
  defaultLifecycleLogger({
    event: "server_initialization_failed",
    level: "error",
    code: "SERVER_INITIALIZATION_FAILED",
    message: error.message,
  });
  process.exit(1);
});
